#!/bin/bash
cd "$(dirname "$0")"

echo "================================================="
echo "Запуск локального сервера для просмотра карты..."
echo "================================================="
echo "Открывается окно браузера..."

# Ждем полсекунды и открываем браузер
(sleep 0.5 && open "http://localhost:8000") &

# Запускаем сервер python
python3 -m http.server 8000
